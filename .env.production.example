# Produção (docker-compose.prod.yml). Copie para .env.production e preencha; nunca commite o real.
# Valores com espaço ou $ entre aspas simples (o Compose interpola $ fora delas).

# Domínio público: veiculos.smebc.com.br (o Caddy do servidor aponta para 127.0.0.1:8001).

# Banco (a senha só vale na primeira criação do volume)
POSTGRES_USER=gve
POSTGRES_DB=gve
POSTGRES_PASSWORD=

# Administrador inicial (docker compose run --rm migrar npm run db:seed -w backend).
# SEED_ADMIN_SENHA é obrigatória em produção; o administrador troca no primeiro acesso.
SEED_ADMIN_NOME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_CPF=
SEED_ADMIN_SENHA=
