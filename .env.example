# Banco de dados (docker compose)
POSTGRES_USER=gve
POSTGRES_PASSWORD=gve
POSTGRES_DB=gve
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gve:gve@localhost:5432/gve

# Backend
API_PORT=3333

# Seed (npm run db:seed). Fora de produção a senha padrão é admin123;
# em qualquer caso o administrador troca a senha no primeiro acesso.
SEED_ADMIN_NOME=Administrador
SEED_ADMIN_EMAIL=admin@gve.local
SEED_ADMIN_CPF=52998224725
SEED_ADMIN_SENHA=
