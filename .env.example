# Banco de dados (docker compose)
POSTGRES_USER=gve
POSTGRES_PASSWORD=gve
POSTGRES_DB=gve
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gve:gve@localhost:5432/gve

# Backend
# development | test | production. Em produção é obrigatório: liga o cookie Secure e o
# trust proxy (IP real do cliente atrás do Nginx). Sem ele, a sessão viaja sem Secure.
# NODE_ENV=development
API_PORT=3333
# Banco dos testes do backend. Padrão: o mesmo servidor de DATABASE_URL, banco gve_teste.
# DATABASE_URL_TESTE=
# Importação de feriados nacionais (RF17). Padrão: https://brasilapi.com.br/api
# BRASILAPI_URL=

# Seed (npm run db:seed). Fora de produção a senha padrão é admin123;
# em qualquer caso o administrador troca a senha no primeiro acesso.
SEED_ADMIN_NOME=Administrador
SEED_ADMIN_EMAIL=admin@gve.local
SEED_ADMIN_CPF=52998224725
SEED_ADMIN_SENHA=
